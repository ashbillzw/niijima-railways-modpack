diff --git a/src/forge/java/createvvvfsim/RailJointSound.java b/src/forge/java/createvvvfsim/RailJointSound.java
new file mode 100644
index 0000000..9c562ea
--- /dev/null
+++ b/src/forge/java/createvvvfsim/RailJointSound.java
@@ -0,0 +1,197 @@
+package createvvvfsim;
+
+import com.simibubi.create.content.trains.entity.CarriageContraptionEntity;
+import com.simibubi.create.content.trains.entity.Train;
+import genengine.RollingRun;
+import java.util.ArrayList;
+import java.util.Map;
+import java.util.WeakHashMap;
+import net.minecraftforge.client.event.ClientPlayerNetworkEvent;
+import java.util.List;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.commands.Commands;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.sounds.SoundEvent;
+import net.minecraft.sounds.SoundSource;
+import net.minecraft.util.Mth;
+import net.minecraft.world.phys.Vec3;
+import net.minecraftforge.api.distmarker.Dist;
+import net.minecraftforge.client.event.RegisterClientCommandsEvent;
+import net.minecraftforge.event.TickEvent;
+import net.minecraftforge.eventbus.api.SubscribeEvent;
+import net.minecraftforge.fml.common.Mod;
+
+@Mod.EventBusSubscriber(modid = Configs.mod_id, value = Dist.CLIENT)
+public class RailJointSound {
+    private static final List<SoundEvent> SAMPLES = List.of(sample(1), sample(2), sample(3));
+    private static final int RUN = -1;
+    private static int selected = RUN;
+    private static volatile RollingRun[] audible = new RollingRun[0];
+    private final RollingRun run = new RollingRun();
+    private double packetSpeed, volume = 1, filteredSpeed;
+    private long packetTick = Long.MIN_VALUE;
+    private record Hit(ClientLevel level, long tick, double fraction, Vec3 pos, float volume, float pitch) {}
+    private static final List<Hit> pending = new ArrayList<>();
+
+    private static final Map<Train, RailJointSound> trains = new WeakHashMap<>();
+    private long lastTick = Long.MIN_VALUE;
+    private double phase;
+    private Vec3 from, to;
+    private double cameraDistance;
+    private TrainSoundPoint source;
+
+    private static SoundEvent sample(int id) {
+        return SoundEvent.createVariableRangeEvent(new ResourceLocation("niijima_rail_audio", "rail_joint_" + id));
+    }
+
+    @SubscribeEvent
+    public static void register(RegisterClientCommandsEvent event) {
+        var root = Commands.literal("railjointdebug");
+        root.then(Commands.literal("run").executes(context -> select(RUN)));
+        for (int i = 0; i <= SAMPLES.size(); i++) {
+            int choice = i;
+            root.then(Commands.literal(i == 0 ? "off" : Integer.toString(i)).executes(context -> select(choice)));
+        }
+        var command = event.getDispatcher().register(root);
+        event.getDispatcher().register(Commands.literal("撞轨音调试").redirect(command));
+    }
+
+    private static int select(int choice) {
+        selected = choice;
+        trains.clear();
+        pending.clear();
+        audible = new RollingRun[0];
+        return 1;
+    }
+
+    public static void sync(Train train, double speed, int tone, int volume) {
+        if (tone == 0) {
+            trains.remove(train);
+            return;
+        }
+        var sound = trains.get(train);
+        var level = Minecraft.getInstance().level;
+        if (sound == null || level == null) return;
+        sound.packetSpeed = Math.abs(speed);
+        sound.packetTick = level.getGameTime();
+        sound.volume = volume / 100.0;
+    }
+
+    public static void mix(double[] left, double[] right) {
+        for (var run : audible) run.mix(left, right);
+    }
+
+    public static void tick(CarriageContraptionEntity car, boolean inPortal) {
+        var mc = Minecraft.getInstance();
+        if (selected == 0 || car.firstPositionUpdate || inPortal || car.getCarriage().train.derailed || mc.level != car.level() || mc.cameraEntity == null)
+            return;
+        Vec3 pos = car.position();
+        double cameraDistance = mc.cameraEntity.distanceToSqr(pos);
+        var point = TrainSoundPoint.get(car.getCarriage().train);
+        if (point == null || point.distance() >= 32) return;
+        Vec3 old = new Vec3(car.xo, car.yo, car.zo);
+        if (pos.distanceToSqr(old) > 8 * 8) return;
+        var sound = trains.computeIfAbsent(car.getCarriage().train, key -> new RailJointSound());
+        if (sound.from == null || cameraDistance < sound.cameraDistance) {
+            sound.source = point;
+            sound.from = old;
+            sound.to = pos;
+            sound.cameraDistance = cameraDistance;
+        }
+    }
+
+    // One synthetic phrase per train. A nearby carriage supplies only motion and a world-space source.
+    private void advance(ClientLevel level) {
+        if (from == null) return;
+        Vec3 old = from, pos = to;
+        from = to = null;
+        long tick = level.getGameTime();
+        if (tick == lastTick) return;
+        boolean continuous = tick == lastTick + 1;
+        if (!continuous) phase = 0;
+        lastTick = tick;
+        double distance = pos.distanceTo(old);
+        if (selected == RUN) {
+            double speed = packetTick >= tick - 20 && packetTick <= tick ? packetSpeed : distance * 20;
+            filteredSpeed = !continuous ? speed : filteredSpeed + .25 * (speed - filteredSpeed);
+            if (speed == 0 && filteredSpeed < .05) filteredSpeed = 0;
+            double near = Math.max(0, 1 - source.distance() / 32);
+            run.set(filteredSpeed, near * volume, source.pan(), Configs.sample_rate.get());
+            return;
+        }
+        if (distance < 0.0001) return;
+        double period = Configs.rail_joint_spacing.get();
+        double shortGap = Configs.rail_coupler_bogey_spacing.get();
+        double longGap = Configs.rail_bogey_spacing.get();
+        double secondPair = period * shortGap / (shortGap + longGap);
+        // Leave room between pairs even with extreme user settings.
+        double axleGap = Math.min(Configs.rail_axle_spacing.get(), 0.5 * Math.min(secondPair, period - secondPair));
+        double end = phase + distance;
+        float speed = (float)distance;
+        float volume = 0.65f * Mth.clamp(speed / 1.25f, 0.08f, 1);
+        float pitch = Mth.clamp(speed / 1.25f, 0.75f, 1.5f);
+        // Half-open interval: a beat at the tick boundary is played exactly once.
+        for (int pair = 0; pair < 2; pair++) {
+            for (int axle = 0; axle < 2; axle++) {
+                double beat = pair * secondPair + axle * axleGap;
+                if (beat < phase) beat += period;
+                for (; beat < end; beat += period) {
+                    double fraction = (beat - phase) / distance;
+                    pending.add(new Hit(level, tick, fraction, source.location(), volume, pitch));
+                }
+            }
+        }
+        phase = end % period;
+    }
+
+    @SubscribeEvent
+    public static void logout(ClientPlayerNetworkEvent.LoggingOut event) {
+        trains.clear();
+        pending.clear();
+        audible = new RollingRun[0];
+    }
+
+    @SubscribeEvent
+    public static void play(TickEvent.RenderTickEvent event) {
+        if (event.phase == TickEvent.Phase.END) playDue(event.renderTickTime);
+    }
+
+    @SubscribeEvent
+    public static void flush(TickEvent.ClientTickEvent event) {
+        if (event.phase != TickEvent.Phase.END) return;
+        var mc = Minecraft.getInstance();
+        if (mc.level == null) {
+            if (audible.length > 0) audible = new RollingRun[0];
+            return;
+        }
+        if (mc.isPaused()) return;
+        if (selected == RUN) {
+            var nearby = new ArrayList<RollingRun>();
+            for (var sound : trains.values()) {
+                if (sound.from == null) continue;
+                sound.advance(mc.level);
+                nearby.add(sound.run);
+            }
+            audible = nearby.toArray(RollingRun[]::new);
+        } else {
+            for (var sound : trains.values()) sound.advance(mc.level);
+        }
+        playDue(0);
+    }
+
+    private static void playDue(float partialTick) {
+        if (pending.isEmpty()) return;
+        var mc = Minecraft.getInstance();
+        if (mc.isPaused()) return;
+        pending.removeIf(hit -> {
+            if (mc.level != hit.level) return true;
+            long age = mc.level.getGameTime() - hit.tick;
+            if (age < 0 || age > 1) return true;
+            if (age == 0 && partialTick < hit.fraction) return false;
+            mc.level.playLocalSound(hit.pos.x, hit.pos.y, hit.pos.z, SAMPLES.get(selected - 1),
+                    SoundSource.NEUTRAL, hit.volume, hit.pitch, false);
+            return true;
+        });
+    }
+}
