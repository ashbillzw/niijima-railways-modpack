diff --git a/src/main/java/genengine/RollingRun.java b/src/main/java/genengine/RollingRun.java
new file mode 100644
index 0000000..b1d03ac
--- /dev/null
+++ b/src/main/java/genengine/RollingRun.java
@@ -0,0 +1,104 @@
+package genengine;
+
+import java.io.BufferedInputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import javax.sound.sampled.AudioSystem;
+import javax.sound.sampled.UnsupportedAudioFileException;
+
+/** One playback cursor per train. The stereo recording and resampling filters are shared. */
+public final class RollingRun {
+    private static final int SOURCE_RATE = 44100;
+    private static final int TAPS = 32, PHASES = 64, CUTOFFS = 32;
+    private static final short[] PCM = loadRecording();
+    private static final float[][] FILTERS = makeFilters();
+    private double cursor, rate, gain, pan;
+    private volatile double targetRate, targetGain, targetPan;
+
+    public void set(double metresPerSecond, double listenerGain, double listenerPan, int outputRate) {
+        targetPan = listenerPan;
+        double kmh = metresPerSecond * 3.6;
+        double ratio = kmh / 75;
+        if (kmh > 75) {
+            // Match the linear slope at 75 km/h and flatten at 1.5x at 200 km/h.
+            double t = Math.min(1, (kmh - 75) / 125);
+            ratio = 1.5 - 0.5 * (1 - t) * (1 - t) / (1 + (4.0 / 3) * t);
+        }
+        targetRate = ratio * SOURCE_RATE / outputRate;
+        double u = Math.max(0, Math.min(1, (kmh - 10) / 10));
+        double fade = u * u * (3 - 2 * u);
+        targetGain = fade * fade * listenerGain * 0.93972443; // -26 LUFS-I over the reference run.
+    }
+
+    public void mix(double[] left, double[] right) {
+        double nextRate = targetRate, nextGain = targetGain, nextPan = targetPan;
+        if (nextGain == 0 && gain == 0) {
+            // Advance the loop through the silent approach with the same rate ramp.
+            cursor = (cursor + (rate + nextRate) * left.length / 2 + (nextRate - rate) / 2) % (PCM.length / 2);
+            rate = nextRate;
+            pan = nextPan;
+            return;
+        }
+        double rateStep = (nextRate - rate) / left.length;
+        double gainStep = (nextGain - gain) / left.length;
+        double panStep = (nextPan - pan) / left.length;
+        int frames = PCM.length / 2;
+        for (int i = 0; i < left.length; i++) {
+            rate += rateStep;
+            gain += gainStep;
+            int centre = (int) cursor;
+            int phase = (int)((cursor - centre) * PHASES);
+            int band = Math.max(1, (int)Math.round(CUTOFFS / Math.max(1, rate)));
+            float[] filter = FILTERS[(band - 1) * PHASES + phase];
+            int frame = centre - TAPS / 2 + 1;
+            if (frame < 0) frame += frames;
+            double l = 0, r = 0;
+            for (float weight : filter) {
+                l += PCM[2 * frame] * weight;
+                r += PCM[2 * frame + 1] * weight;
+                if (++frame == frames) frame = 0;
+            }
+            pan += panStep;
+            left[i] += l * gain * (1 - Math.max(0, pan));
+            right[i] += r * gain * (1 + Math.min(0, pan));
+            cursor = (cursor + rate) % frames;
+        }
+        rate = nextRate;
+        gain = nextGain;
+        pan = nextPan;
+    }
+
+    private static short[] loadRecording() {
+        String file = "/assets/niijima_rail_audio/Run_Ballast25m.wav";
+        try (var stream = new BufferedInputStream(RollingRun.class.getResourceAsStream(file));
+             var audio = AudioSystem.getAudioInputStream(stream)) {
+            var data = ByteBuffer.wrap(audio.readAllBytes()).order(ByteOrder.LITTLE_ENDIAN).asShortBuffer();
+            short[] samples = new short[data.remaining()];
+            data.get(samples);
+            return samples;
+        } catch (IOException | UnsupportedAudioFileException e) {
+            throw new IllegalStateException(file, e);
+        }
+    }
+
+    // Windowed sinc; lower the cutoff when playing faster to avoid aliasing.
+    private static float[][] makeFilters() {
+        float[][] bank = new float[CUTOFFS * PHASES][TAPS];
+        for (int b = 1; b <= CUTOFFS; b++) {
+            double cutoff = (double)b / CUTOFFS;
+            for (int p = 0; p < PHASES; p++) {
+                float[] filter = bank[(b - 1) * PHASES + p];
+                double sum = 0;
+                for (int j = 0; j < TAPS; j++) {
+                    double x = j - TAPS / 2 + 1 - (double)p / PHASES;
+                    double sinc = x == 0 ? cutoff : Math.sin(Math.PI * cutoff * x) / (Math.PI * x);
+                    filter[j] = (float)(sinc * (.5 + .5 * Math.cos(2 * Math.PI * x / TAPS)));
+                    sum += filter[j];
+                }
+                for (int j = 0; j < TAPS; j++) filter[j] /= sum * 32768;
+            }
+        }
+        return bank;
+    }
+}
diff --git a/src/forge/java/createvvvfsim/TrainSoundPoint.java b/src/forge/java/createvvvfsim/TrainSoundPoint.java
new file mode 100644
index 0000000..621fc77
--- /dev/null
+++ b/src/forge/java/createvvvfsim/TrainSoundPoint.java
@@ -0,0 +1,61 @@
+package createvvvfsim;
+
+import com.simibubi.create.content.trains.entity.Carriage;
+import com.simibubi.create.content.trains.entity.Train;
+import java.util.WeakHashMap;
+import net.minecraft.client.Minecraft;
+import net.minecraft.util.Mth;
+import net.minecraft.world.phys.Vec3;
+import utils.PosHandler;
+
+/** The closest audible point on the loaded part of one train, in listener space and world space. */
+public record TrainSoundPoint(long tick, Vec3 location, Vec3 offset, double distance, double pan) {
+    private static final WeakHashMap<Train, TrainSoundPoint> points = new WeakHashMap<>();
+
+    public static TrainSoundPoint get(Train train) {
+        var mc = Minecraft.getInstance();
+        if (mc.level == null || mc.cameraEntity == null) return null;
+        long tick = mc.level.getGameTime();
+        TrainSoundPoint cached = points.get(train);
+        if (cached != null && cached.tick == tick) return cached;
+        Vec3 ear = mc.cameraEntity.getEyePosition();
+        Vec3 best = null, previous = null;
+        for (Carriage car : train.carriages) {
+            var dce = car.getDimensionalIfPresent(mc.level.dimension());
+            var entity = dce == null ? null : dce.entity.get();
+            if (entity == null || entity.isRemoved() || !dce.pointsInitialised || dce.pivot != null) {
+                previous = null;
+                continue;
+            }
+            Vec3 front = dce.leadingAnchor(), rear = dce.trailingAnchor();
+            if (front == null || rear == null) {
+                previous = null;
+                continue;
+            }
+            front = PosHandler.convert(front, mc.level);
+            rear = PosHandler.convert(rear, mc.level);
+            if (previous != null) best = nearer(ear, best, project(ear, previous, front));
+            best = nearer(ear, best, project(ear, front, rear));
+            previous = rear;
+        }
+        if (best == null) return null;
+        Vec3 delta = best.subtract(ear);
+        double distance = delta.length();
+        var left = mc.gameRenderer.getMainCamera().getLeftVector();
+        double pan = -(delta.x * left.x() + delta.y * left.y() + delta.z * left.z()) / Math.max(1, distance);
+        var point = new TrainSoundPoint(tick, best, delta, distance, Mth.clamp(pan, -1, 1));
+        points.put(train, point);
+        return point;
+    }
+
+    static Vec3 project(Vec3 ear, Vec3 a, Vec3 b) {
+        Vec3 axis = b.subtract(a);
+        double length2 = axis.lengthSqr();
+        if (length2 == 0) return a;
+        return a.add(axis.scale(Mth.clamp(ear.subtract(a).dot(axis) / length2, 0, 1)));
+    }
+
+    private static Vec3 nearer(Vec3 ear, Vec3 best, Vec3 candidate) {
+        return best == null || ear.distanceToSqr(candidate) < ear.distanceToSqr(best) ? candidate : best;
+    }
+}
