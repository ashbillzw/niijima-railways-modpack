@@ -0,0 +1,25 @@
+package createvvvfsim;
+
+import java.util.List;
+
+public interface TrainTone {
+    // Stable identifiers on the wire, names on disk.
+    List<String> PRESETS = List.of("create", "siemens", "alstom", "tn27", "toyodenki");
+
+    // Complete VVVF mix at -20 LUFS-I over the 48-second near-field reference run.
+    static double playbackGain(int tone, int volume) {
+        double gainAt100 = switch (PRESETS.get(tone)) {
+            case "siemens" -> 1.892344;
+            case "alstom" -> 2.412682;
+            case "tn27" -> 1.792669;
+            case "toyodenki" -> 1.009254;
+            default -> 1.0;
+        };
+        return gainAt100 * volume / 100.0;
+    }
+
+    int niijima$getVolume();
+    void niijima$setVolume(int volume);
+    int niijima$getTone();
+    void niijima$setTone(int tone);
+}
