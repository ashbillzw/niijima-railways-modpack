+package createvvvfsim;
+
+import com.mojang.brigadier.arguments.IntegerArgumentType;
+import com.mojang.brigadier.builder.LiteralArgumentBuilder;
+import com.mojang.brigadier.exceptions.CommandSyntaxException;
+import com.simibubi.create.Create;
+import com.simibubi.create.content.trains.entity.CarriageContraptionEntity;
+import com.simibubi.create.content.trains.entity.Train;
+import java.lang.ref.WeakReference;
+import java.util.Map;
+import java.util.WeakHashMap;
+import net.minecraft.commands.CommandSourceStack;
+import net.minecraft.commands.Commands;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraftforge.event.RegisterCommandsEvent;
+import net.minecraftforge.eventbus.api.SubscribeEvent;
+import net.minecraftforge.fml.common.Mod;
+
+@Mod.EventBusSubscriber(modid = Configs.mod_id)
+public class TrainToneCommand {
+    private static final Map<ServerPlayer, WeakReference<CarriageContraptionEntity>> controls = new WeakHashMap<>();
+
+    public static void tookControls(ServerPlayer player, CarriageContraptionEntity carriage) {
+        controls.put(player, new WeakReference<>(carriage));
+    }
+
+    private static Train selectedTrain(ServerPlayer player) {
+        if (player.getVehicle() instanceof CarriageContraptionEntity seat && seat.getCarriage() != null
+                && seat.getContraption().getSeatOf(player.getUUID()) != null)
+            return seat.getCarriage().train;
+
+        var current = controls.get(player);
+        var cab = current == null ? null : current.get();
+        if (cab != null && cab.level() == player.level() && !cab.isRemoved() && cab.getCarriage() != null
+                && cab.getControllingPlayer().filter(player.getUUID()::equals).isPresent())
+            return cab.getCarriage().train;
+        return null;
+    }
+
+    private static Train editableTrain(CommandSourceStack source, String denied) throws CommandSyntaxException {
+        ServerPlayer player = source.getPlayerOrException();
+        Train train = selectedTrain(player);
+        if (train == null)
+            source.sendFailure(Component.literal("请先点击列车座位或驾驶台"));
+        else if (player.getUUID().equals(train.owner) || player.hasPermissions(2))
+            return train;
+        else
+            source.sendFailure(Component.literal(denied));
+        return null;
+    }
+
+    @SubscribeEvent
+    public static void register(RegisterCommandsEvent event) {
+        LiteralArgumentBuilder<CommandSourceStack> root = Commands.literal("列车音色");
+        for (String preset : TrainTone.PRESETS) {
+            root.then(Commands.literal(preset).executes(ctx -> {
+                Train train = editableTrain(ctx.getSource(), "仅车主或管理员可更改音色");
+                if (train == null) return 0;
+                ((TrainTone) train).niijima$setTone(TrainTone.PRESETS.indexOf(preset));
+                Create.RAILWAYS.markTracksDirty();
+                ctx.getSource().sendSuccess(() -> Component.literal("已将" + train.name.getString() + "的音色设为" + preset), false);
+                return 1;
+            }));
+        }
+        var percent = Commands.argument("percent", IntegerArgumentType.integer(0, 200)).executes(ctx -> {
+            Train train = editableTrain(ctx.getSource(), "仅车主或管理员可更改列车音量");
+            if (train == null) return 0;
+            int volume = IntegerArgumentType.getInteger(ctx, "percent");
+            ((TrainTone) train).niijima$setVolume(volume);
+            Create.RAILWAYS.markTracksDirty();
+            ctx.getSource().sendSuccess(() -> Component.literal("已将" + train.name.getString() + "的列车音量设为" + volume + "%"), false);
+            return 1;
+        }).build();
+        root.then(Commands.literal("音量").then(percent));
+        root.then(Commands.literal("yinliang").then(percent));
+        var command = event.getDispatcher().register(root);
+        event.getDispatcher().register(Commands.literal("liecheyinse").redirect(command));
+        event.getDispatcher().register(Commands.literal("vvvf").redirect(command));
+    }
+}
