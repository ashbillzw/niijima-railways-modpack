{
  "gamemode": "creative",
  "steps": [
    {"op":"command","command":"fill $x-4 199 -4 $x+11 199 7 stone"},
    {"op":"command","command":"tp @s $x+0.5 200 0.5 -90 20"},
    {"op":"waitWorld"},
    {"op":"command","command":"setblock $x+3 200 -1 createaddition:liquid_blaze_burner[blaze=smouldering]"},
    {"op":"command","command":"setblock $x+3 201 -1 cauldron"},
    {"op":"command","command":"setblock $x+4 201 -1 dispenser[facing=west]{Items:[{Slot:0b,id:\"minecraft:water_bucket\",Count:1b}]}"},
    {"op":"command","command":"setblock $x+5 201 -1 redstone_block"},
    {"op":"command","command":"setblock $x-2 200 0 repeating_command_block{auto:1b}"},
    {"op":"command","command":"data modify block $x-2 200 0 Command set value \"execute if block $x+3 200 -1 createaddition:liquid_blaze_burner[blaze=smouldering] if block $x+3 201 -1 amendments:liquid_cauldron[boiling=true] run setblock ~1 ~ ~ yellow_concrete\""},
    {"op":"expectBlock","dx":-1,"dy":0,"dz":0,"block":"minecraft:yellow_concrete","timeout":35},
    {"op":"command","command":"setblock $x-2 200 0 air"},
    {"op":"command","command":"setblock $x+4 200 -1 create:glass_fluid_pipe[axis=x]"},
    {"op":"command","command":"setblock $x+5 200 -1 create:mechanical_pump[facing=west]"},
    {"op":"command","command":"setblock $x+6 200 -1 create:fluid_tank"},
    {"op":"command","command":"data modify block $x+6 200 -1 TankContent set value {FluidName:\"minecraft:lava\",Amount:1000}"},
    {"op":"command","command":"setblock $x+5 200 0 create:cogwheel[axis=x]"},
    {"op":"command","command":"setblock $x+6 200 0 create:creative_motor[facing=west]"},
    {"op":"command","command":"setblock $x-2 200 0 repeating_command_block{auto:1b}"},
    {"op":"command","command":"data modify block $x-2 200 0 Command set value \"execute if block $x+3 200 -1 createaddition:liquid_blaze_burner[blaze=kindled] if block $x+3 201 -1 amendments:liquid_cauldron[boiling=true] run setblock ~1 ~ ~ orange_concrete\""},
    {"op":"expectBlock","dx":-1,"dy":0,"dz":0,"block":"minecraft:orange_concrete","timeout":35},
    {"op":"command","command":"setblock $x-2 200 0 air"},
    {"op":"command","command":"setblock $x+3 200 3 createaddition:liquid_blaze_burner[blaze=smouldering]"},
    {"op":"command","command":"setblock $x+3 201 3 create:fluid_tank"},
    {"op":"command","command":"setblock $x+4 201 3 create:steam_engine[face=wall,facing=east]"},
    {"op":"command","command":"setblock $x+6 201 3 create:shaft[axis=z]"},
    {"op":"command","command":"setblock $x-2 200 0 repeating_command_block{auto:1b}"},
    {"op":"command","command":"data modify block $x-2 200 0 Command set value \"execute if block $x+3 200 3 createaddition:liquid_blaze_burner[blaze=smouldering] if block $x+3 201 3 create:fluid_tank{Boiler:{Engines:1,PassiveHeat:1b,ActiveHeat:0}} run setblock ~1 ~ ~ cyan_concrete\""},
    {"op":"expectBlock","dx":-1,"dy":0,"dz":0,"block":"minecraft:cyan_concrete","timeout":35},
    {"op":"command","command":"setblock $x-2 200 0 air"},
    {"op":"command","command":"setblock $x+4 200 3 create:glass_fluid_pipe[axis=x]"},
    {"op":"command","command":"setblock $x+5 200 3 create:mechanical_pump[facing=west]"},
    {"op":"command","command":"setblock $x+6 200 3 create:fluid_tank"},
    {"op":"command","command":"data modify block $x+6 200 3 TankContent set value {FluidName:\"minecraft:lava\",Amount:1000}"},
    {"op":"command","command":"setblock $x+5 200 4 create:cogwheel[axis=x]"},
    {"op":"command","command":"setblock $x+6 200 4 create:creative_motor[facing=west]"},
    {"op":"command","command":"setblock $x-2 200 0 repeating_command_block{auto:1b}"},
    {"op":"command","command":"data modify block $x-2 200 0 Command set value \"execute if block $x+3 200 3 createaddition:liquid_blaze_burner[blaze=kindled] if block $x+3 201 3 create:fluid_tank{Boiler:{Engines:1,ActiveHeat:1}} run setblock ~1 ~ ~ green_concrete\""},
    {"op":"expectBlock","dx":-1,"dy":0,"dz":0,"block":"minecraft:green_concrete","timeout":35},
    {"op":"command","command":"setblock $x-2 200 0 air"},
    {"op":"screenshot"}
  ]
}
